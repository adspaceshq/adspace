PORT=8080
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adspaces
# Download the CA certificate from Supabase database settings.
DATABASE_SSL=verify-full
DATABASE_CA_CERT=./supabase-ca.crt
DATABASE_POOL_SIZE=10
SESSION_TTL_HOURS=168
# Set to the number of trusted reverse proxies in production (usually 1).
# TRUST_PROXY=1

# Same Privy app as the frontend. App ID is public; App Secret is server-only.
# Dashboard → Configuration → App settings → Basics
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_AUTHORIZATION_PRIVATE_KEY=your-base64-pkcs8-private-key

# Cloudinary media storage. API secret is server-only; never expose it to frontend.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=adspaces

# Step 3: who can review submissions. Comma-separated X handles (@ optional)
# or stable user IDs (survives handle renames). Empty = no reviewers.
# PLATFORM_REVIEWERS=@you

SOLANA_NETWORK=devnet
ADSPACES_PROGRAM_ID=6ft49ExLRbHUcY6crReW7qibZLrS5rdCudKWQRp2LMSW
# Platform review-authority keypair. Keep the secret out of git; use either
# the JSON keypair contents or an absolute path to the Solana keypair file.
ADSPACES_REVIEWER_WALLET=your-review-authority-public-key
# ADSPACES_REVIEWER_KEYPAIR=[1,2,...]
# ADSPACES_REVIEWER_KEYPAIR_PATH=C:/secure/adspaces-devnet.json
ADSPACES_FEE_BPS=250
ADSPACES_UPLIFT_FEE_BPS=1000
ADSPACES_MAX_FEE_BPS=1000
ADSPACES_REVIEW_WINDOW_SECONDS=172800
ADSPACES_DELIVERY_WINDOW_SECONDS=259200
# Optional dedicated RPC endpoints. Required before enabling chain reads or transactions.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WEBSOCKET_URL=wss://api.devnet.solana.com
# Maximum USDC a user can withdraw during a rolling 24-hour period.
WITHDRAWAL_DAILY_LIMIT_USDC=1000

# Get paid (devnet USDC): with the reviewer keypair configured, pay settles
# through the on-chain program; without it, reviewers paste the Solana
# transfer signature as the pay reference. Sig-like refs verify
# amount+destination+USDC mint on-chain when SOLANA_RPC_URL is set.
# Strict mode requires a sig + verification.
# PAYOUT_REQUIRE_ONCHAIN=1
# USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# PLATFORM_FEE_BPS=0
