PORT=8080
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adspaces
# Download the CA certificate from Supabase database settings.
DATABASE_SSL=verify-full
DATABASE_CA_CERT=./supabase-ca.crt
DATABASE_POOL_SIZE=10
SESSION_TTL_HOURS=168
# Session cookie: the deployed API and frontend are cross-site, so production
# defaults to SameSite=None + Secure (sent on cross-site fetch, unlike Lax).
# Override only for same-origin local dev: SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_SAMESITE=none
# Behind Render/Fly/Railway the app sits behind a proxy — required so Secure
# cookies and client IPs resolve correctly.
# TRUST_PROXY=1

# Same Privy app as the frontend. App ID is public; App Secret is server-only.
# Dashboard → Configuration → App settings → Basics
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_AUTHORIZATION_PRIVATE_KEY=your-base64-pkcs8-private-key

# Cloudinary media storage. API secret is server-only; never expose it to frontend.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=adspaces

# Team roles. Comma-separated user IDs or Privy DIDs (never handles: they can be renamed).
# Reviewers approve listings and propose dispute decisions; admins also pause, change settings and
# manage the team. More reviewers and admins can be added in the app (review → ops → team). Empty = no reviewers.
# PLATFORM_REVIEWERS=@you
# PLATFORM_ADMINS=did:privy:...

# Solana. RPC_URL and USDC_MINT are required for anything on-chain; the server refuses to start
# without them. The RPC URL is the only place the paid RPC key belongs (the frontend makes no RPC calls).
SOLANA_NETWORK=devnet
ADSPACES_PROGRAM_ID=8Vg24teSaNrY4AmksQ8hZw2z2RRPuobeCtir7jVTYGw5
# Platform review-authority keypair: co-signs listings, pays fees and rent. Required for on-chain
# actions. Keep it out of git; set either the JSON keypair contents or an absolute path to the file.
# ADSPACES_REVIEWER_KEYPAIR=[1,2,...]
# ADSPACES_REVIEWER_KEYPAIR_PATH=C:/secure/adspaces-devnet.json
# Squads v4 multisig whose vault (index 0) is the program's config authority. When set, dispute
# resolutions and resume become Squads proposals created by the reviewer key, which must be a
# multisig member with Initiate permission only. Unset: the reviewer key must be the config authority.
# SQUADS_MULTISIG=FiSZco2iyXnVEQbs7FUYUyaPU7kXHSYZGyk8t4gpNfjU
# Hours an admin proposal (resume, dispute timeout) stays executable: its valid_until is the cluster
# clock plus this. The program refuses it afterwards (rebuild it) and caps it at 168 (7 days).
# SQUADS_PROPOSAL_TTL_HOURS=24
# Resolve proposals need SOL in the multisig vault (index 0) to re-create a token account a party
# closed before execution (about 0.002 SOL each); keep at least 0.01 SOL there.
# Fallback for disputes when the platform key can't sign or is out of SOL: the buyer's embedded
# wallet pays the dispute rent (~0.0053 SOL, returned when the dispute closes) and the fee. The
# program allows it only once proof exists. Embedded wallets usually hold no SOL, so off by default.
# BUYER_PAID_DISPUTES=true
# Fees, the review window and the dispute timeout live on-chain (program config and each listing),
# so there is nothing to set for them here.
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WEBSOCKET_URL=wss://api.devnet.solana.com
# Circle USDC: devnet below; mainnet is EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Maximum USDC a user can withdraw during a rolling 24-hour period.
WITHDRAWAL_DAILY_LIMIT_USDC=1000

# Get paid (devnet USDC): with the reviewer keypair configured, pay settles
# through the on-chain program; without it, reviewers paste the Solana
# transfer signature as the pay reference. Sig-like refs verify
# amount+destination+USDC mint on-chain when SOLANA_RPC_URL is set.
# Strict mode requires a sig + verification.
# PAYOUT_REQUIRE_ONCHAIN=1

# Notification emails (Resend; same account as the waitlist). Without a key notifications are in-app only.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=hello@adspaces.fun
NOTIFY_INTERVAL_MS=30000

# Background jobs and alerts.
# Reconciler: settles transactions and on-chain changes the API didn't send itself (0 turns it off).
# RECONCILE_INTERVAL_MS=300000
# Helius webhook (Raw, our program ID) pointing at /api/webhooks/helius, with this value as its
# authentication header: program activity is reconciled within seconds. Unset: route disabled.
# HELIUS_WEBHOOK_SECRET=
# DEPOSIT_CHECK_INTERVAL_MS=120000
# Operator alerts (failed transactions, reconciler drift, low fee payer), emailed to ALERT_EMAILS.
# MONITOR_INTERVAL_MS=300000
# MIN_FEE_PAYER_LAMPORTS=1000000000
# ALERT_EMAILS=you@example.com
