    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
