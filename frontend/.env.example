NEXT_PUBLIC_API_URL=http://localhost:8080

# Privy App ID from https://dashboard.privy.io → Configuration → App settings → Basics
# Also enable X (Twitter) under Login methods → Socials, and add
# http://localhost:3000 to Allowed origins (Domains) while developing.
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
NEXT_PUBLIC_PRIVY_SIGNER_ID=your-privy-signer-id

# devnet for testing, mainnet-beta for prod
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_ADSPACES_PROGRAM_ID=6ft49ExLRbHUcY6crReW7qibZLrS5rdCudKWQRp2LMSW
NEXT_PUBLIC_ADSPACES_PAYMENT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Use a private devnet RPC in deployment and keep its API key outside Git.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WEBSOCKET_URL=wss://api.devnet.solana.com

# Preset imagery (Mac photos, tee preview, landing art) served from the
# adspaces-static Cloudflare R2 bucket. Only needed for a custom domain —
# e.g. https://assets.adspaces.fun — otherwise the pub-xxx.r2.dev default
# in src/lib/assets.ts is used. No trailing slash.
# NEXT_PUBLIC_STATIC_ASSET_BASE=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
